{
  "name": "transpose",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^11.3.0",
    "typescript": ">=6 <7"
  },
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit",
    "check:design": "sync-engine check-design design/concepts/*.md design/types.md",
    "test": "bun test",
    "test:memory": "TEST_MONGO=memory bun test",
    "start": "bun src/main.ts",
    "dev": "bun run db:up && bun --watch src/main.ts",
    "sandbox": "bun src/sandbox/server.ts",
    "db:up": "docker compose up -d --wait mongo",
    "db:shell": "docker compose exec mongo mongosh -u dev -p dev",
    "db:logs": "docker compose logs mongo",
    "db:reset": "docker compose down -v"
  },
  "overrides": {
    "bson": "7.2.0"
  }
}
